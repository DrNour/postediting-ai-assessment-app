# Copy this file to .streamlit/secrets.toml for local use.
# In Streamlit Community Cloud, paste the same values into App settings > Secrets.
# Never commit the real secrets.toml file.

SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
# Use a server-side Supabase key. Keep it only in Streamlit Secrets and never print it.
SUPABASE_KEY = "your_supabase_server_key"

# Protects all teacher, AI, dashboard, and research pages.
TEACHER_PASSWORD = "replace_with_a_long_random_password"

# Optional: required only for AI-generated feedback.
OPENAI_API_KEY = ""
